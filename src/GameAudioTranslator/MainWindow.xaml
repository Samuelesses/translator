<Window x:Class="GameAudioTranslator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Audio Translator" Height="880" Width="520"
        MinHeight="700" MinWidth="460">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="Setup" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Margin="6">
                <TextBlock Text="OpenAI API Key:" VerticalAlignment="Center" Width="120"/>
                <PasswordBox x:Name="ApiKeyBox" Width="240"/>
                <Button x:Name="SaveKeyButton" Content="Save" Margin="8,0,0,0" Click="SaveKeyButton_Click"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="Listen" Margin="0,0,0,8">
            <StackPanel Margin="6">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Capture from:" VerticalAlignment="Center" Width="120"/>
                    <RadioButton x:Name="DeviceModeRadio" GroupName="CaptureMode" Content="This device's audio"
                                 IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0"
                                 Checked="CaptureMode_Changed"/>
                    <RadioButton x:Name="AppModeRadio" GroupName="CaptureMode" Content="A specific application"
                                 VerticalAlignment="Center" Checked="CaptureMode_Changed"/>
                </StackPanel>

                <StackPanel x:Name="DevicePanel" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Audio device:" VerticalAlignment="Center" Width="120"/>
                    <ComboBox x:Name="DeviceCombo" Width="240"/>
                    <Button x:Name="RefreshDevicesButton" Content="Refresh" Margin="8,0,0,0" Click="RefreshDevicesButton_Click"/>
                </StackPanel>

                <StackPanel x:Name="AppPanel" Orientation="Horizontal" Margin="0,0,0,8" Visibility="Collapsed">
                    <TextBlock Text="Application:" VerticalAlignment="Center" Width="120"/>
                    <ComboBox x:Name="ProcessCombo" Width="240"/>
                    <Button x:Name="RefreshProcessesButton" Content="Refresh" Margin="8,0,0,0" Click="RefreshProcessesButton_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Sensitivity:" VerticalAlignment="Center" Width="120"/>
                    <Slider x:Name="SensitivitySlider" Width="240" Minimum="0.002" Maximum="0.08" Value="0.02" TickFrequency="0.002"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="StartStopButton" Content="Start Listening" Width="140" Click="StartStopButton_Click"/>
                    <CheckBox x:Name="ShowOverlayCheck" Content="Show overlay captions" Margin="16,0,0,0"
                              VerticalAlignment="Center" IsChecked="True"
                              Checked="ShowOverlayCheck_Changed" Unchecked="ShowOverlayCheck_Changed"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="Reply (Ctrl+Alt+R)" Margin="0,0,0,8">
            <StackPanel Margin="6">
                <TextBlock x:Name="LastLanguageText" Text="Last language heard: none yet" Foreground="Gray" FontSize="11" Margin="0,0,0,8"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button x:Name="ReplyButton" Content="Start Reply" Width="140" Click="ReplyButton_Click"/>
                    <Button x:Name="ReplayButton" Content="Replay" Width="90" Margin="8,0,0,0" IsEnabled="False" Click="ReplayButton_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Speech speed:" VerticalAlignment="Center" Width="120"/>
                    <Slider x:Name="SpeechSpeedSlider" Width="200" Minimum="0.5" Maximum="2.0" Value="1.0"
                            TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="SpeechSpeedSlider_ValueChanged"/>
                    <TextBlock x:Name="SpeechSpeedLabel" Text="1.0x" Width="40" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="Voice Output (let others hear you)" Margin="0,0,0,8">
            <StackPanel Margin="6">
                <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,8"
                           Text="Lets FiveM voice chat hear your real voice plus your translated replies. Requires installing a free virtual audio cable first (e.g. VB-Audio Virtual Cable) and setting FiveM's microphone to its output device - this app can't create that device itself, no app can."/>

                <CheckBox x:Name="VoicePassthroughCheck" Content="Enable virtual mic passthrough" Margin="0,0,0,8"
                          Checked="VoicePassthroughCheck_Changed" Unchecked="VoicePassthroughCheck_Changed"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Microphone:" VerticalAlignment="Center" Width="120"/>
                    <ComboBox x:Name="MicCombo" Width="240"/>
                    <Button x:Name="RefreshMicsButton" Content="Refresh" Margin="8,0,0,0" Click="RefreshMicsButton_Click"/>
                </StackPanel>
                <TextBlock Text="This microphone is also what Reply (above) records from." Foreground="Gray" FontSize="11" Margin="0,-4,0,8"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Virtual cable:" VerticalAlignment="Center" Width="120"/>
                    <ComboBox x:Name="CableCombo" Width="240"/>
                    <Button x:Name="RefreshCablesButton" Content="Refresh" Margin="8,0,0,0" Click="RefreshCablesButton_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Mic boost:" VerticalAlignment="Center" Width="120"/>
                    <Slider x:Name="MicGainSlider" Width="200" Minimum="1.0" Maximum="4.0" Value="2.0"
                            TickFrequency="0.1" ValueChanged="MicGainSlider_ValueChanged"/>
                    <TextBlock x:Name="MicGainLabel" Text="2.0x" Width="40" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <TextBlock Grid.Row="4" x:Name="StatusText" Text="Status: idle" Margin="0,0,0,8" Foreground="Gray"/>

        <ListBox Grid.Row="5" x:Name="CaptionList" Margin="0,0,0,8" DisplayMemberPath="Display"/>

        <TextBlock Grid.Row="6" TextWrapping="Wrap" Foreground="Gray" FontSize="11"
                   Text="Ctrl+Alt+O shows/hides the overlay; Ctrl+Alt+L unlocks it to drag (locked = click-through). 'A specific application' needs Windows 10 2004+/11 - pick FiveM once it's running, then Refresh if it's not listed yet."/>
    </Grid>
</Window>
