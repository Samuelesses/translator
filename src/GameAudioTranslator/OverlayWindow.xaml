<Window x:Class="GameAudioTranslator.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Overlay" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        ResizeMode="NoResize" WindowStartupLocation="Manual"
        Width="600" SizeToContent="Height"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border x:Name="RootBorder" Background="#B0000000" CornerRadius="8" Padding="16,10" BorderThickness="0">
        <StackPanel x:Name="LinesPanel" Orientation="Vertical"/>
    </Border>
</Window>
